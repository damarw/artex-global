# syntax=docker/dockerfile:1
#
# Lapisan alat tambahan di atas image ARTEX resmi.
#
# Kenapa lapisan terpisah, bukan mengubah Dockerfile utama:
#   - Dockerfile utama hanya menyalin binary yang sudah dikompilasi CI. Menambah alat di sana
#     berarti membangun ulang seluruh alur rilis setiap kali ada alat baru.
#   - Di sini kita extend image rilis, jadi tetap bisa memakai tag versi (ARTEX_TAG) dan
#     pembaruan upstream tidak bentrok.
#
# Pakai:
#   docker compose -f docker-compose.yml -f docker/tools-compose.yml up -d --build
#
# Isi: pemindai CVE (nuclei), injeksi SQL (sqlmap), fuzz path (ffuf), probe HTTP (httpx),
# out-of-band (interactsh), dan jwt_tool untuk kelas authentication-jwt.
FROM ghcr.io/jiwoochris/artex-global:${ARTEX_TAG:-latest}

ARG NUCLEI_VERSION=3.11.1
ARG FFUF_VERSION=2.3.0
ARG HTTPX_VERSION=1.12.0
ARG INTERACTSH_VERSION=1.4.1
ARG SQLMAP_TAG=1.10

USER root

# --- binary Go dari GitHub Releases (tanpa kompilasi) -------------------------
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) a=amd64 ;; arm64) a=arm64 ;; \
      *) echo "arsitektur tidak didukung: $arch" >&2; exit 1 ;; esac; \
    get() { curl -fsSL --retry 3 -o /tmp/x.zip "$1"; unzip -oq /tmp/x.zip -d /usr/local/bin "$2"; chmod +x "/usr/local/bin/$2"; rm -f /tmp/x.zip; }; \
    get "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${a}.zip" nuclei; \
    get "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_${a}.zip" httpx; \
    get "https://github.com/projectdiscovery/interactsh/releases/download/v${INTERACTSH_VERSION}/interactsh-client_${INTERACTSH_VERSION}_linux_${a}.zip" interactsh-client; \
    curl -fsSL --retry 3 -o /tmp/ffuf.tar.gz "https://github.com/ffuf/ffuf/releases/download/v${FFUF_VERSION}/ffuf_${FFUF_VERSION}_linux_${a}.tar.gz"; \
    tar -xzf /tmp/ffuf.tar.gz -C /usr/local/bin ffuf; chmod +x /usr/local/bin/ffuf; rm -f /tmp/ffuf.tar.gz; \
    nuclei -version; ffuf -V; httpx -version

# --- sqlmap ------------------------------------------------------------------
RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/sqlmap.tar.gz "https://github.com/sqlmapproject/sqlmap/archive/refs/tags/${SQLMAP_TAG}.tar.gz"; \
    tar -xzf /tmp/sqlmap.tar.gz -C /opt; \
    mv "/opt/sqlmap-${SQLMAP_TAG}" /opt/sqlmap; \
    ln -sf /opt/sqlmap/sqlmap.py /usr/local/bin/sqlmap; \
    chmod +x /opt/sqlmap/sqlmap.py; \
    sqlmap --version

# --- jwt_tool ----------------------------------------------------------------
RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/jwt.tar.gz "https://github.com/ticarpi/jwt_tool/archive/refs/heads/master.tar.gz"; \
    tar -xzf /tmp/jwt.tar.gz -C /opt; \
    mv /opt/jwt_tool-master /opt/jwt_tool; \
    python3 -m pip install --no-cache-dir -q -r /opt/jwt_tool/requirements.txt; \
    printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' > /usr/local/bin/jwt_tool; \
    chmod +x /usr/local/bin/jwt_tool; \
    jwt_tool -h >/dev/null

# --- searchsploit (exploitdb) -------------------------------------------------
# PoC publik per produk/versi, offline. Dipakai skill cve-chain sebelum menyimpulkan "tidak ada PoC".
ARG EXPLOITDB_REPO=https://gitlab.com/exploit-database/exploitdb.git
RUN set -eux; \
    git clone --depth 1 "$EXPLOITDB_REPO" /opt/exploitdb || \
      git clone --depth 1 https://github.com/offensive-security/exploitdb.git /opt/exploitdb; \
    ln -sf /opt/exploitdb/searchsploit /usr/local/bin/searchsploit; \
    searchsploit --version 2>/dev/null || searchsploit -h | head -2

# --- katana (crawler JS-aware) + dalfox (XSS) ---------------------------------
ARG KATANA_VERSION=1.8.0
ARG DALFOX_VERSION=3.3.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) a=amd64; d=x86_64 ;; arm64) a=arm64; d=aarch64 ;; \
      *) echo "arsitektur tidak didukung: $arch" >&2; exit 1 ;; esac; \
    curl -fsSL --retry 3 -o /tmp/k.zip "https://github.com/projectdiscovery/katana/releases/download/v${KATANA_VERSION}/katana_${KATANA_VERSION}_linux_${a}.zip"; \
    unzip -oq /tmp/k.zip -d /usr/local/bin katana; chmod +x /usr/local/bin/katana; rm -f /tmp/k.zip; \
    curl -fsSL --retry 3 -o /tmp/d.tgz "https://github.com/hahwul/dalfox/releases/download/v${DALFOX_VERSION}/dalfox-v${DALFOX_VERSION}-linux-${d}.tar.gz"; \
    mkdir -p /tmp/dx && tar -xzf /tmp/d.tgz -C /tmp/dx; \
    cp /tmp/dx/dalfox-v${DALFOX_VERSION}-linux-${d}/dalfox /usr/local/bin/dalfox; chmod +x /usr/local/bin/dalfox; \
    rm -rf /tmp/d.tgz /tmp/dx; \
    katana -version; dalfox --version

# --- Metasploit Framework ------------------------------------------------------
# Berat (~1 GB). Bisa dimatikan saat build: --build-arg INSTALL_MSF=0
ARG INSTALL_MSF=1
RUN set -eux; \
    if [ "$INSTALL_MSF" = "1" ]; then \
      curl -fsSL --retry 3 https://apt.metasploit.com/metasploit-framework.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/metasploit.gpg; \
      echo "deb [signed-by=/usr/share/keyrings/metasploit.gpg] https://apt.metasploit.com/ lucid main" \
        > /etc/apt/sources.list.d/metasploit.list; \
      apt-get update; \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends metasploit-framework; \
      rm -rf /var/lib/apt/lists/*; \
      msfconsole -v; \
    else echo "Metasploit dilewati (INSTALL_MSF=0)"; fi

# --- commix (command injection) + ysoserial (deserialisasi) --------------------
ARG COMMIX_TAG=4.1
ARG YSOSERIAL_VERSION=0.0.6
RUN set -eux; \
    # commix: python, tanpa dependensi berat
    curl -fsSL --retry 3 -o /tmp/commix.tar.gz "https://github.com/commixproject/commix/archive/refs/tags/v${COMMIX_TAG}.tar.gz"; \
    tar -xzf /tmp/commix.tar.gz -C /opt; \
    mv "/opt/commix-${COMMIX_TAG}" /opt/commix; \
    printf '#!/bin/sh\nexec python3 /opt/commix/commix.py "$@"\n' > /usr/local/bin/commix; \
    chmod +x /usr/local/bin/commix /opt/commix/commix.py; rm -f /tmp/commix.tar.gz; \
    # ysoserial: butuh JRE headless (~120MB) — dipakai untuk gadget deserialisasi Java
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends default-jre-headless; \
    rm -rf /var/lib/apt/lists/*; \
    curl -fsSL --retry 3 -o /opt/ysoserial.jar \
      "https://github.com/frohoff/ysoserial/releases/download/v${YSOSERIAL_VERSION}/ysoserial-all.jar"; \
    printf '#!/bin/sh\nexec java -jar /opt/ysoserial.jar "$@"\n' > /usr/local/bin/ysoserial; \
    chmod +x /usr/local/bin/ysoserial; \
    printf '#!/bin/sh\njava -jar /opt/ysoserial.jar 2>&1 | head -40\n' > /usr/local/bin/ysoserial-info; \
    chmod +x /usr/local/bin/ysoserial-info; \
    commix --version | head -2; java -version 2>&1 | head -1

# --- gerbang mode deep: kill switch + budget percobaan -------------------------
COPY deeptool /usr/local/bin/deeptool
COPY pentest /usr/local/bin/pentest
RUN chmod 0755 /usr/local/bin/deeptool /usr/local/bin/pentest && \
    ln -sf /usr/local/bin/deeptool /usr/local/bin/deep && \
    deeptool status >/dev/null && pentest info >/dev/null 2>&1 || true; \
    echo "deeptool + pentest siap"

# Template nuclei di-bake supaya scan pertama tidak menunggu unduhan (~13 ribu template).
# Diambil lewat git clone karena rilis nuclei-templates tidak menyediakan arsip siap unduh.
# Kalau jaringan build diblokir, langkah ini dilewati dan nuclei mengunduh saat pemakaian.
RUN set -eux; \
    rm -rf /root/nuclei-templates; \
    (git clone --depth 1 --single-branch \
       https://github.com/projectdiscovery/nuclei-templates.git /root/nuclei-templates \
       && rm -rf /root/nuclei-templates/.git) || echo "templates dilewati: jaringan build menolak git clone"

ENV ARTEX_TOOLS_LAYER=1
