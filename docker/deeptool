#!/usr/bin/env python3
"""deeptool — kill switch + attempt budget for exploitation-level actions.

Every L2+ action (proof-of-access, controlled impact) must run through this wrapper.
It is a guardrail, not a sandbox: the hard fence is still human approval plus the network
boundary. What it does guarantee:

  * off by default — nothing runs until `deeptool enable`
  * stops on demand — `deeptool stop` (or touching the STOP file) refuses instantly
  * expires — every enable has a TTL
  * bounded repetition — per-action-key attempts and a global budget
  * audited — one JSON line per executed command in audit.jsonl

State lives in $DEEP_DIR (default /app/data/deep), outside the repo.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path(os.environ.get("DEEP_DIR", "/app/data/deep"))
STATE = STATE_DIR / "state.json"
STOP = STATE_DIR / "STOP"
AUDIT = STATE_DIR / "audit.jsonl"

DEFAULT_MAX_ATTEMPTS = 40
DEFAULT_PER_KEY = 2
MAX_TTL_SECONDS = 4 * 3600

# Commands refused outright, even with deep mode enabled.
#
# Policy (client-approved):
#   ALLOWED  — account creation, RCE/shell (proof of access, then close it)
#   BLOCKED  — destructive or irreversible: DROP/DELETE/TRUNCATE, unbounded UPDATE, file deletion,
#              encryption/wiping (ransomware-shaped commands), account deletion, persistence,
#              mass data collection, credential brute force
BLOCKED = [
    (r"\brm\s+-rf?\s+/(?!tmp|var/tmp)", "recursive delete of a system path"),
    (r"\bfind\s+/\S*\s+.*-delete\b", "bulk file deletion"),
    (r"\bmkfs\.|\bdd\s+if=.*of=/dev/", "filesystem write"),
    (r"\bshutdown\b|\breboot\b|\binit\s+0\b|\bpoweroff\b", "host shutdown"),
    (r"\bdrop\s+(table|database|schema)\b", "destructive SQL"),
    (r"\btruncate\s+table\b", "destructive SQL"),
    (r"\bdelete\s+from\s+\w+\s*(;|$)", "unbounded DELETE"),
    (r"\bupdate\s+\w+\s+set\b(?![^\n]*\bwhere\b)", "unbounded UPDATE"),
    (r"\b(userdel|groupdel)\b", "account deletion"),
    # encryption / wiping — ransomware-shaped, never part of a proof
    (r"\bopenssl\s+enc\b|\bgpg\s+(-c|--symmetric)\b|\bgpg\s+.*--encrypt\b", "encryption of data"),
    (r"\bshred\b|\bwipe\b|\bsrm\b|\bsecure-delete\b", "data wiping"),
    (r"\btruncate\s+-s\s*0\b|>\s*/etc/(passwd|shadow)\b", "file truncation of system files"),
    (r"\bchattr\s+\+i\b", "file locking"),
    (r"(crontab\s+-|/etc/cron\.|systemctl\s+enable|systemd-run)", "persistence"),
    (r"authorized_keys|\.ssh/", "ssh key persistence"),
    (r"\bhydra\b|\bmedusa\b", "credential brute force (use bounded checks instead)"),
    # mass collection — the line between "proof" and "harvesting"
    (r"\{1\.\.\d{2,}\}", "bulk enumeration (brace range)"),
    (r"\bseq\s+\d+\s+\d{3,}", "bulk enumeration (seq range)"),
    (r"\bfor\s+\w+\s+in\s+\$?\(?\s*seq\b", "enumeration loop"),
    (r"\bwhile\s+read\b.*\bcurl\b|\bfor\s+\w+\s+in\s+\$\(\s*cat\b", "enumeration loop over a list"),
    (r"\bxargs\b[^|]*-P\s*([2-9]|\d{2,})", "parallel bulk requests"),
    (r"(^|\s)parallel\s+-", "parallel bulk requests"),
    (r"\bmasscan\b", "mass scanning"),
    (r"\bwfuzz\b|\bferoxbuster\b[^|]*-t\s*([3-9]\d|\d{3,})", "bulk fuzzing"),
    (r"--continue-at\b.*--output\b.*\{", "bulk download loop"),
]


def now() -> float:
    return time.time()


def load() -> dict:
    if not STATE.exists():
        return {"enabled": False, "level": 0, "expires": 0, "max_attempts": DEFAULT_MAX_ATTEMPTS,
                "used": 0, "per_key_max": DEFAULT_PER_KEY, "keys": {}, "created": now()}
    try:
        return json.loads(STATE.read_text())
    except Exception:
        return {"enabled": False, "level": 0, "expires": 0, "max_attempts": DEFAULT_MAX_ATTEMPTS,
                "used": 0, "per_key_max": DEFAULT_PER_KEY, "keys": {}, "created": now()}


def save(st: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2))
    os.chmod(tmp, 0o600)
    tmp.replace(STATE)


def audit(entry: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with AUDIT.open("a") as fh:
        fh.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), **entry}) + "\n")
    os.chmod(AUDIT, 0o600)


def parse_ttl(s: str) -> int:
    m = re.fullmatch(r"(\d+)([smh]?)", s.strip())
    if not m:
        raise SystemExit("ttl harus angka + satuan s/m/h, contoh 45m")
    n, unit = int(m.group(1)), m.group(2) or "s"
    return n * {"s": 1, "m": 60, "h": 3600}[unit]


def do_enable(level: int, ttl: str, max_attempts: int, per_key: int, source: str) -> int:
    secs = min(parse_ttl(ttl), MAX_TTL_SECONDS)
    st = load()
    st.update(enabled=True, level=level, expires=now() + secs, used=0, keys={},
              max_attempts=max_attempts, per_key_max=per_key)
    save(st)
    if STOP.exists():
        STOP.unlink()
    audit({"event": "enable", "level": level, "ttl_s": secs, "max_attempts": max_attempts,
           "per_key_max": per_key, "source": source})
    return secs


def do_disable(source: str = "cli") -> None:
    st = load()
    st["enabled"] = False
    save(st)
    audit({"event": "disable", "source": source})


def do_stop(source: str = "cli") -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STOP.write_text(f"stopped {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\n")
    st = load()
    st["enabled"] = False
    save(st)
    audit({"event": "stop", "source": source})


def cmd_enable(a) -> int:
    ttl = do_enable(a.level, a.ttl, a.max_attempts, a.per_key, "cli")
    print(f"deep mode ON — level L{a.level}, kedaluwarsa dalam {ttl}s, "
          f"budget {a.max_attempts} aksi, maks {a.per_key}x per hipotesis")
    return 0


def cmd_disable(_) -> int:
    do_disable("cli")
    print("deep mode OFF")
    return 0


def cmd_stop(_) -> int:
    do_stop("cli")
    print("STOP: semua aksi L2+ ditolak sampai `deeptool enable` dijalankan lagi")
    return 0


def cmd_status(_) -> int:
    st = load()
    left = max(0, int(st.get("expires", 0) - now()))
    keys = st.get("keys", {})
    print(json.dumps(status(), indent=2))
    return 0


def status() -> dict:
    st = load()
    left = max(0, int(st.get("expires", 0) - now()))
    return {
        "enabled": bool(st.get("enabled")) and left > 0 and not STOP.exists(),
        "level": st.get("level", 0),
        "expires_in_s": left,
        "used": st.get("used", 0),
        "max_attempts": st.get("max_attempts", DEFAULT_MAX_ATTEMPTS),
        "per_key_max": st.get("per_key_max", DEFAULT_PER_KEY),
        "keys": st.get("keys", {}),
        "stop_file": STOP.exists(),
        "state_dir": str(STATE_DIR),
    }


def cmd_run(a) -> int:
    st = load()
    key = a.key or "default"
    # refusals first, in order of severity
    if STOP.exists():
        print("DITOLAK: deep mode dihentikan (STOP file).", file=sys.stderr)
        audit({"event": "refuse", "reason": "stop", "key": key, "cmd": a.cmd})
        return 3
    if not st.get("enabled"):
        print("DITOLAK: deep mode mati. Jalankan `deeptool enable` lebih dulu.", file=sys.stderr)
        audit({"event": "refuse", "reason": "disabled", "key": key, "cmd": a.cmd})
        return 3
    if st.get("expires", 0) <= now():
        print("DITOLAK: sesi deep mode kedaluwarsa.", file=sys.stderr)
        audit({"event": "refuse", "reason": "expired", "key": key, "cmd": a.cmd})
        return 3
    if st.get("used", 0) >= st.get("max_attempts", DEFAULT_MAX_ATTEMPTS):
        print(f"DITOLAK: budget habis ({st['used']}/{st['max_attempts']}).", file=sys.stderr)
        audit({"event": "refuse", "reason": "budget", "key": key, "cmd": a.cmd})
        return 3
    used_key = st.get("keys", {}).get(key, 0)
    if used_key >= st.get("per_key_max", DEFAULT_PER_KEY):
        print(f"DITOLAK: hipotesis '{key}' sudah dicoba {used_key}x (maks {st['per_key_max']}).",
              file=sys.stderr)
        audit({"event": "refuse", "reason": "per_key", "key": key, "cmd": a.cmd})
        return 3

    line = " ".join(a.cmd) if isinstance(a.cmd, list) else str(a.cmd)
    for pattern, why in BLOCKED:
        if re.search(pattern, line, re.I):
            print(f"DITOLAK: pola berbahaya ({why}).", file=sys.stderr)
            audit({"event": "refuse", "reason": "blocklist", "why": why, "key": key, "cmd": line})
            return 4

    st["used"] = st.get("used", 0) + 1
    st.setdefault("keys", {})[key] = used_key + 1
    save(st)
    audit({"event": "exec", "level": st.get("level"), "key": key,
           "attempt": st["used"], "cmd": line})
    try:
        rc = subprocess.call(a.cmd if isinstance(a.cmd, list) else line, shell=not isinstance(a.cmd, list))
    except FileNotFoundError as e:
        print(f"perintah tidak ditemukan: {e}", file=sys.stderr)
        return 127
    audit({"event": "exit", "key": key, "rc": rc, "cmd": line})
    return rc


def cmd_log(a) -> int:
    if not AUDIT.exists():
        print("belum ada catatan")
        return 0
    for ln in AUDIT.read_text().splitlines()[-a.tail:]:
        print(ln)
    return 0


def cmd_record(a) -> int:
    """Ungated L0/L1 action — recorded, but no enable needed."""
    st = load()
    if STOP.exists():
        print("DITOLAK: deep mode dihentikan (STOP file).", file=sys.stderr)
        audit({"event": "refuse", "reason": "stop", "key": a.key, "cmd": a.cmd})
        return 3
    line = " ".join(a.cmd)
    for pattern, why in BLOCKED:
        if re.search(pattern, line, re.I):
            print(f"DITOLAK: pola berbahaya ({why}).", file=sys.stderr)
            audit({"event": "refuse", "reason": "blocklist", "why": why, "key": a.key, "cmd": line})
            return 4
    audit({"event": "exec", "level": 1, "key": a.key, "cmd": line})
    t0 = now()
    try:
        rc = subprocess.call(a.cmd if len(a.cmd) > 1 else line, shell=len(a.cmd) == 1)
    except FileNotFoundError as e:
        print(f"perintah tidak ditemukan: {e}", file=sys.stderr)
        return 127
    audit({"event": "exit", "key": a.key, "rc": rc, "ms": int((now() - t0) * 1000), "cmd": line})
    return rc


