def cmd_serve(a) -> int:
    import secrets
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse, parse_qs

    token = os.environ.get("DEEP_TOKEN") or secrets.token_urlsafe(12)
    audit({"event": "serve_start", "port": a.port})
    print(f"deepctl: http://127.0.0.1:{a.port}/?token={token}", flush=True)

    class H(BaseHTTPRequestHandler):
        def _send(self, body: bytes, ctype: str):
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _json(self, obj, code=200):
            body = json.dumps(obj).encode()
            if code != 200:
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            self._send(body, "application/json")

        def _auth(self, q) -> bool:
            got = (q.get("token") or [self.headers.get("X-Deep-Token", "")])[0]
            if got != token:
                self._json({"error": "token salah"}, 403)
                return False
            return True

        def log_message(self, *args):
            pass

        def do_GET(self):
            u = urlparse(self.path)
            q = parse_qs(u.query)
            if u.path == "/":
                return self._send(PAGE.encode(), "text/html; charset=utf-8")
            if not self._auth(q):
                return
            if u.path == "/status":
                return self._json(status())
            if u.path == "/log":
                tail = int((q.get("tail") or ["25"])[0])
                lines = AUDIT.read_text().splitlines()[-tail:] if AUDIT.exists() else []
                return self._json({"lines": lines})
            return self._json({"error": "tidak ada"}, 404)

        def do_POST(self):
            u = urlparse(self.path)
            q = parse_qs(u.query)
            if not self._auth(q):
                return
            if u.path == "/stop":
                do_stop("button")
                return self._json({"ok": True, "stopped": True})
            if u.path == "/disable":
                st = load()
                st["enabled"] = False
                save(st)
                audit({"event": "disable", "source": "button"})
                return self._json({"ok": True})
            if u.path == "/enable":
                lvl = int((q.get("level") or ["2"])[0])
                ttl = (q.get("ttl") or ["30m"])[0]
                mx = int((q.get("max_attempts") or [str(DEFAULT_MAX_ATTEMPTS)])[0])
                pk = int((q.get("per_key") or [str(DEFAULT_PER_KEY)])[0])
                do_enable(lvl, ttl, mx, pk, "button")
                return self._json({"ok": True, "level": lvl})
            return self._json({"error": "tidak ada"}, 404)

    ThreadingHTTPServer(("0.0.0.0", a.port), H).serve_forever()
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="deeptool", description="kill switch + attempt budget untuk aksi eksploitasi")
    sub = p.add_subparsers(dest="action", required=True)

    e = sub.add_parser("enable", help="nyalakan deep mode dengan TTL dan budget")
    e.add_argument("--level", type=int, default=2, choices=[2, 3, 4], help="L2 PoC baca, L3 dampak terkontrol, L4 post-exploit (lab)")
    e.add_argument("--ttl", default="60m", help="durasi izin, contoh 30m / 2h (maks 4h)")
    e.add_argument("--max-attempts", type=int, default=DEFAULT_MAX_ATTEMPTS, help="total aksi diizinkan")
    e.add_argument("--per-key", type=int, default=DEFAULT_PER_KEY, help="maks percobaan per hipotesis")
    e.set_defaults(func=cmd_enable)

    for name, fn, helptext in (("disable", cmd_disable, "matikan tanpa menghapus state"),
                               ("stop", cmd_stop, "hentikan darurat (STOP file)"),
                               ("status", cmd_status, "lihat status")):
        s = sub.add_parser(name, help=helptext)
        s.set_defaults(func=fn)

    r = sub.add_parser("run", help="jalankan satu aksi di bawah izin yang aktif")
    r.add_argument("--key", default="default", help="nama hipotesis untuk hitungan percobaan")
    r.add_argument("cmd", nargs=argparse.REMAINDER, help="perintah, contoh: -- curl -s '...'")
    r.set_defaults(func=cmd_run)

    rec = sub.add_parser("record", help="aksi L0/L1 — dicatat, tidak butuh enable")
    rec.add_argument("--key", default="recon")
    rec.add_argument("cmd", nargs=argparse.REMAINDER)
    rec.set_defaults(func=cmd_record)

    lg = sub.add_parser("log", help="baca catatan audit")
    lg.add_argument("--tail", type=int, default=20)
    lg.set_defaults(func=cmd_log)

    sv = sub.add_parser("serve", help="tombol kontrol di browser (STOP / enable / log)")
    sv.add_argument("--port", type=int, default=8790)
    sv.set_defaults(func=cmd_serve)

    a = p.parse_args()
    if getattr(a, "cmd", None) and isinstance(a.cmd, list) and a.cmd and a.cmd[0] == "--":
        a.cmd = a.cmd[1:]
    return a.func(a)


if __name__ == "__main__":
    sys.exit(main())
